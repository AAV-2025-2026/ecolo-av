// The WiFi the ESP32 joins with `--features wifi-status`. Copy this file to
// src/wifi_secrets.rs (git ignores that name) and put the real ones there; never in
// this file, a commit, a log or a doc. Ask the hardware lead for them.
// The inherited repos' old passwords are public: never use or copy one (Q34).

/// The network's name.
pub const SSID: &str = "example-network";
/// Its WPA2 password.
pub const PASSWORD: &str = "example-password";
/// With `--features wifi-update` only: the password `/update` asks for (the
/// `X-Update-Password` header), at least 12 characters. This example's is always refused.
/// Make up a new one; never a WiFi password, never one from the inherited repos.
pub const UPDATE_PASSWORD: &str = "example-update-password";
