<?xml version="1.0"?>
<!--
  Gazebo Harmonic (gz-sim 8, the Jazzy pairing) additions, included when sim:=true.
  Plugin and element names checked against the gz-sim8 / gz-sensors8 sources.

  Gazebo topics (bridged to ROS by aav_gazebo/config/bridge.yaml):
    /model/aav/cmd_vel        gz.msgs.Twist      in:  v, w  (the Ackermann system turns
                                                      w into a steering angle, bicycle model)
    /model/aav/odometry       gz.msgs.Odometry   out: ground-truth-ish odometry
    /aav/imu                  gz.msgs.IMU        out
    /aav/navsat               gz.msgs.NavSat     out (needs <spherical_coordinates> in the world)
    /world/<world>/model/aav/joint_state          out: wheel and steering joints

  The odometry frame names are odom -> base_link, but we do NOT bridge Gazebo's TF:
  robot_localization owns odom -> base_link, exactly as on the car.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <gazebo>
    <plugin filename="gz-sim-ackermann-steering-system"
            name="gz::sim::systems::AckermannSteering">
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <left_steering_joint>front_left_steering_joint</left_steering_joint>
      <right_steering_joint>front_right_steering_joint</right_steering_joint>
      <kingpin_width>${T}</kingpin_width>
      <!-- Not max_steering_angle: Gazebo makes it a radius, wheel_base / sin(limit), and
           stopped the car at 0.447 rad when given 0.5. description.launch.py passes the
           limit that gives the centre wheel max_steering_angle (vehicle.py,
           gazebo_steering_limit). Missing: xacro stops here rather than steer short. -->
      <steering_limit>${float('$(arg gz_steering_limit)')}</steering_limit>
      <steer_p_gain>10.0</steer_p_gain>  <!-- the default lags over 1 s, and Nav2 weaves -->
      <wheel_base>${L}</wheel_base>
      <wheel_separation>${T}</wheel_separation>
      <wheel_radius>${R}</wheel_radius>
      <min_velocity>-6.0</min_velocity>
      <max_velocity>6.0</max_velocity>
      <!-- Wide on purpose (15 Oct): gazebo_adapter's actuator model limits the speed and
           steering (vehicle.yaml actuators:), not Gazebo. They were -3.0 and +1.5; with
           actuator_model:=false the adapter keeps those old limits itself. -->
      <min_acceleration>-10.0</min_acceleration>
      <max_acceleration>10.0</max_acceleration>
      <topic>/model/aav/cmd_vel</topic>
      <odom_topic>/model/aav/odometry</odom_topic>
      <tf_topic>/model/aav/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher"/>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <always_on>1</always_on>
      <update_rate>50</update_rate>
      <topic>/aav/imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.2</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.2</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.2</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <gazebo reference="gps_link">
    <sensor name="navsat" type="navsat">
      <always_on>1</always_on>
      <update_rate>5</update_rate>
      <topic>/aav/navsat</topic>
      <gz_frame_id>gps_link</gz_frame_id>
      <navsat>
        <position_sensing>
          <!-- Gazebo adds this to latitude and longitude, so it's in degrees:
               4.5e-6 degrees is about 0.5 m. (0.5 here once meant 55 km.) -->
          <horizontal><noise type="gaussian"><mean>0</mean><stddev>4.5e-6</stddev></noise></horizontal>
          <vertical><noise type="gaussian"><mean>0</mean><stddev>1.0</stddev></noise></vertical>
        </position_sensing>
      </navsat>
    </sensor>
  </gazebo>

</robot>
