<?xml version="1.0"?>
<!--
  A person-sized post, 0.5 x 0.5 m and 1.8 m tall, for the lidar's obstacle check
  (tools/sim_check.py). The roof lidar's lowest beam (15 degrees down from 1.8 m) meets it all
  the way to the front bumper, so the lidar alone can stop the car for it; the 1 m box it
  loses from 2 m ahead of the bumper. Its origin is the centre of its base, on the ground.
-->
<sdf version="1.9">
  <model name="post">
    <static>true</static>
    <link name="link">
      <pose>0 0 0.9 0 0 0</pose>
      <visual name="visual">
        <geometry><box><size>0.5 0.5 1.8</size></box></geometry>
        <material>
          <diffuse>0.1 0.45 0.85 1</diffuse>
          <ambient>0.1 0.45 0.85 1</ambient>
        </material>
      </visual>
      <collision name="collision">
        <geometry><box><size>0.5 0.5 1.8</size></box></geometry>
      </collision>
    </link>
  </model>
</sdf>
