<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aav_spine</name>
  <version>0.1.0</version>
  <description>Backend for the real car on the CAN spine: spine_bridge turns /ego/actuator_cmd and /estop into CAN frames (firmware/can/aav.dbc) through ros2_socketcan, and the spine's feedback into /vehicle/odom, /vehicle/status and /vehicle/joint_states.</description>
  <maintainer email="aav-team@todo.invalid">AAV 2026-27 team</maintainer>
  <license>TODO</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>ackermann_msgs</exec_depend>
  <exec_depend>can_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>aav_interfaces</exec_depend>
  <exec_depend>aav_description</exec_depend>
  <exec_depend>ros2_socketcan</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
