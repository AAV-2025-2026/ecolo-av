<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aav_legacy</name>
  <version>0.1.0</version>
  <description>Interim backend for the 2025-26 hardware: drives the ESP32's UART protocol (version 2 with the Orin's heartbeat, or the 13-byte version 1) from ego's commands (/control/car/actuator_cmd, from the output mux), and turns the UDP wheel encoder into /vehicle/odom. Replaced by aav_spine once the CAN spine exists.</description>
  <maintainer email="aav-team@todo.invalid">AAV 2026-27 team</maintainer>
  <license>TODO</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>ackermann_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>aav_description</exec_depend>
  <exec_depend>aav_interfaces</exec_depend>
  <!-- rc_driver, started beside the bridge (legacy.launch.py rc:=true). -->
  <exec_depend>aav_rc</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>python3-pytest</test_depend>
  <!-- test_heartbeat_chain.py runs the muxes with the bridge. -->
  <test_depend>aav_io_mux</test_depend>
  <!-- test_uplink_chain.py runs rc_driver with the bridge. -->
  <test_depend>aav_rc</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
