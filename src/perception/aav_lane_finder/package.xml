<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aav_lane_finder</name>
  <version>0.1.0</version>
  <description>The lane finder: classic OpenCV finds the lane lines in the front camera's pictures (a bird's-eye warp of a flat road, a mask for the paint, sliding windows, a second-order fit per line) and publishes /perception/lane/geometry, which lane keeping (aav_lane_geometry's control_interface) steers by.</description>
  <maintainer email="aav-team@todo.invalid">AAV 2026-27 team</maintainer>
  <license>TODO</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>aav_lane_geometry</exec_depend>
  <exec_depend>aav_description</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
