{
  "configById": {
    "3D!car": {
      "followMode": "follow-position",
      "followTf": "base_link",
      "cameraState": {"distance": 30, "perspective": true, "phi": 50, "thetaOffset": 0,
                      "targetOffset": [0, 0, 0], "fovy": 45, "near": 0.5, "far": 5000},
      "scene": {"enableStats": false},
      "layers": {
        "grid": {"layerId": "foxglove.Grid", "visible": true, "frameId": "base_link",
                 "size": 40, "divisions": 40, "position": [0, 0, 0]}
      },
      "topics": {
        "/robot_description": {"visible": true},
        "/sensors/lidar/points": {"visible": true, "pointSize": 2, "colorMode": "gradient",
                                  "colorField": "z"},
        "/sensors/radar/points": {"visible": true, "pointSize": 6, "colorMode": "flat",
                                  "flatColor": "#ff3b30"},
        "/perception/radar/cluster_boxes": {"visible": true},
        "/plan": {"visible": true},
        "/drivers/nav/route/path": {"visible": true},
        "/safety/collision_monitor/stop_zone": {"visible": true},
        "/safety/ghost/marker": {"visible": true}
      }
    },
    "Image!camera": {
      "imageMode": {"imageTopic": "/perception/detections/image"}
    },
    "map!gps": {
      "layer": "map",
      "zoomLevel": 18,
      "disabledTopics": []
    },
    "Indicator!sensors": {
      "path": "/safety/sensor_watchdog/lock.data",
      "style": "background",
      "fallbackColor": "#2e7d32",
      "fallbackLabel": "Sensors OK (or no watchdog yet)",
      "rules": [{"operator": "=", "rawValue": "true", "color": "#c62828",
                 "label": "STOP: a sensor Nav2 needs has failed"}]
    },
    "Plot!speed": {
      "paths": [
        {"value": "/vehicle/odom.twist.twist.linear.x", "enabled": true,
         "timestampMethod": "receiveTime", "label": "measured speed (m/s)"},
        {"value": "/control/cmd_vel.twist.linear.x", "enabled": true,
         "timestampMethod": "receiveTime", "label": "commanded speed (m/s)"}
      ],
      "showLegend": true,
      "xAxisVal": "timestamp",
      "followingViewWidth": 30
    },
    "RawMessages!status": {
      "topicPath": "/vehicle/status",
      "diffEnabled": false,
      "expansion": "all"
    }
  },
  "globalVariables": {},
  "userNodes": {},
  "layout": {
    "direction": "row",
    "splitPercentage": 60,
    "first": {
      "direction": "column",
      "splitPercentage": 62,
      "first": "3D!car",
      "second": "Image!camera"
    },
    "second": {
      "direction": "column",
      "splitPercentage": 40,
      "first": "map!gps",
      "second": {
        "direction": "column",
        "splitPercentage": 18,
        "first": "Indicator!sensors",
        "second": {
          "direction": "column",
          "splitPercentage": 50,
          "first": "Plot!speed",
          "second": "RawMessages!status"
        }
      }
    }
  }
}
