<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aav_hud</name>
  <version>0.1.0</version>
  <description>The HUD's back end: a ROS node with a Flask and Socket.IO server for the in-car Flutter app (hud/flutter_pi). It shows /vehicle/status, /localization/gps/fix, /perception/stop_sign and /sensors/camera/front_left/image_raw, and sends the route the app locks to Nav2 as a follow_gps_waypoints goal.</description>
  <maintainer email="aav-team@todo.invalid">AAV 2026-27 team</maintainer>
  <license>TODO</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>geographic_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>aav_interfaces</exec_depend>
  <exec_depend>python3-flask</exec_depend>
  <exec_depend>python3-flask-socketio</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
