      }
    },
    "Image!chase": {
      "imageMode": {
        "imageTopic": "/vehicle/gazebo/chase_camera/compressed"
      }
    },
    "map!gps": {
      "layer": "map",
      "zoomLevel": 18,
      "maxNativeZoom": 18,
      "followTopic": "/localization/gps/fix",
      "disabledTopics": [],
      "topicColors": {
        "/localization/gps/fix": "#2196f3",
        "/sensors/gps/fix": "#ff9800"
      }
    },
    "Indicator!estop": {
      "path": "/vehicle/status.estop_active",
      "style": "background",
      "fallbackColor": "#2e7d32",
      "fallbackLabel": "No e-stop",
      "rules": [
        {
          "operator": "=",
          "rawValue": "true",
          "color": "#c62828",
          "label": "E-STOP"
        }
      ]
    },
    "Indicator!watchdog": {
      "path": "/safety/sensor_watchdog/lock.data",
      "style": "background",
      "fallbackColor": "#2e7d32",
      "fallbackLabel": "Sensors OK (or no watchdog yet)",
      "rules": [
        {
          "operator": "=",
          "rawValue": "true",
          "color": "#c62828",
          "label": "STOP: a sensor Nav2 needs has failed"
        }
      ]
    },
    "Indicator!health": {
      "path": "/localization/health.data",
      "style": "background",
      "fallbackColor": "#f9a825",
      "fallbackLabel": "Localization: WARN (see the text below)",
      "rules": [
        {
          "operator": "=",
          "rawValue": "OK",
          "color": "#2e7d32",
          "label": "Localization: OK"
        }
      ]
    },
    "RawMessages!health": {
      "topicPath": "/localization/health.data",
      "diffEnabled": false,
      "expansion": "all"
    },
    "RawMessages!gate": {
      "topicPath": "/safety/output_mux/state.data",
      "diffEnabled": false,
      "expansion": "all"
    },
    "DiagnosticSummary!all": {
      "topicToRender": "/diagnostics",
      "minLevel": 1,
      "pinnedIds": [],
      "hardwareIdFilter": "",
      "sortByLevel": true,
      "secondsUntilStale": 5
    },
    "Plot!speed": {
      "paths": [
        {
          "value": "/vehicle/odom.twist.twist.linear.x",
          "enabled": true,
          "timestampMethod": "receiveTime",
          "label": "measured speed (m/s)"
        },
        {
          "value": "/control/cmd_vel.twist.linear.x",
          "enabled": true,
          "timestampMethod": "receiveTime",
          "label": "asked speed (m/s)"
        }
      ],
      "showLegend": true,
      "xAxisVal": "timestamp",
      "followingViewWidth": 30
    },
    "Plot!steering": {
      "paths": [
        {
          "value": "/vehicle/steering.measured",
          "enabled": true,
          "timestampMethod": "receiveTime",
          "label": "measured steering (rad, + left)"
        },
        {
          "value": "/vehicle/steering.command",
          "enabled": true,
          "timestampMethod": "receiveTime",
          "label": "asked steering (rad)"
        }
      ],
      "showLegend": true,
      "xAxisVal": "timestamp",
      "followingViewWidth": 30
    },
    "CallService!tracker": {
      "serviceName": "/track/set_parameters",
      "requestPayload": "{\n  \"parameters\": [\n    {\n      \"name\": \"tracker\",\n      \"value\": {\n        \"type\": 4,\n        \"string_value\": \"lqr\"\n      }\n    }\n  ]\n}",
      "layout": "horizontal",
      "buttonText": "Set the tracker",
      "buttonTooltip": "Sim only (live_swap). Write pure_pursuit, stanley, lqr, mpc or mpc_full in string_value, then press. Needs a tracker at launch (tracker:=...): with none, there is no /track to call.",
      "buttonColor": "#1565c0"
    },
    "Table!switches": {
      "topicPath": "/studio_script/launch_switches.switches"
    }
  },
  "globalVariables": {},
  "userNodes": {
    "launch-switches": {
      "name": "launch_switches",
      "sourceCode": "// The launch switches: each one needs a restart (pixi run pick, or pixi run sim ... name:=value).\n// Shown in the cockpit's Table panel. It runs on each /diagnostics message, so it shows\n// whenever something is connected. Nothing here talks to the car.\nimport { Input } from \"./types\";\n\nexport const inputs = [\"/diagnostics\"];\nexport const output = \"/studio_script/launch_switches\";\n\ntype Switch = { switch: string; what: string; values: string };\ntype Output = { restart: string; switches: Switch[] };\n\nconst switches: Switch[] = [\n  { switch: \"planner:=\", what: \"Nav2's planner\", values: \"lattice (default), hybrid; trials: smac2d, navfn, theta_star\" },\n  { switch: \"tracker:=\", what: \"the path follower (the panel above swaps it live)\", values: \"none (default: MPPI), pure_pursuit, stanley, lqr, mpc, mpc_full\" },\n  { switch: \"voxels:=\", what: \"Nav2 sees the lidar as 0.25 m cubes\", values: \"false (default), true\" },\n  { switch: \"amcl:=\", what: \"stock AMCL beside the EKF, scored only (test_lot)\", values: \"false (default), true\" },\n  { switch: \"ndt:=\", what: \"NDT on the lidar map, scored only (test_lot)\", values: \"false (default), true\" },\n  { switch: \"ndt_ekf:=\", what: \"NDT's pose into ekf_global\", values: \"false (default), true\" },\n  { switch: \"kiss_icp:=\", what: \"KISS-ICP lidar odometry, scored only\", values: \"false (default), true\" },\n  { switch: \"kiss_ekf:=\", what: \"KISS-ICP's speed into ekf_local\", values: \"false (default), true\" },\n  { switch: \"chase_camera:=\", what: \"Gazebo's camera behind the car\", values: \"true (default), false\" },\n];\n\nexport default function script(_event: Input<\"/diagnostics\">): Output {\n  return { restart: \"These need a restart: pixi run pick\", switches };\n}\n"
    }
  },
