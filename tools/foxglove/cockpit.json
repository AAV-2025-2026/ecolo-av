        "/perception/voxels/cubes": {
          "visible": true,
          "pointShape": "square",
          "pointSize": 9,
          "colorMode": "colormap",
          "colorField": "z",
          "colorMap": "turbo"
        },
        "/sensors/radar/points": {
          "visible": true,
          "pointSize": 6,
          "colorMode": "flat",
          "flatColor": "#ff3b30"
        },
        "/perception/radar/cluster_boxes": {
          "visible": true
        },
        "/plan": {
          "visible": true,
          "lineWidth": 0.2,
          "color": "#2196f3"
        },
        "/goal_pose": {
          "visible": true,
          "type": "arrow"
        },
        "/drivers/nav/route/path": {
          "visible": true,
