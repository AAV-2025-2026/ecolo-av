{
  "configById": {
    "3D!driving": {
      "followMode": "follow-position",
      "followTf": "base_link",
      "cameraState": {"distance": 30, "perspective": true, "phi": 50, "thetaOffset": 0,
                      "targetOffset": [0, 0, 0], "fovy": 45, "near": 0.5, "far": 5000},
      "scene": {"enableStats": false},
      "layers": {
        "grid": {"layerId": "foxglove.Grid", "visible": true, "frameId": "base_link",
                 "size": 40, "divisions": 40, "position": [0, 0, 0]}
      },
      "topics": {
        "/robot_description": {"visible": true},
        "/local_costmap/costmap": {"visible": true, "colorMode": "costmap", "alpha": 0.5},
        "/sensors/lidar/scan": {"visible": true, "pointSize": 4, "colorMode": "flat",
                                "flatColor": "#00e5ff"},
        "/sensors/radar/points": {"visible": true, "pointSize": 6, "colorMode": "flat",
                                  "flatColor": "#ff3b30"},
        "/perception/radar/cluster_boxes": {"visible": true},
        "/perception/camera_obstacles": {"visible": true, "pointSize": 6, "colorMode": "flat",
                                         "flatColor": "#ffd60a"},
        "/plan": {"visible": true, "lineWidth": 0.15, "color": "#2196f3"},
        "/goal_pose": {"visible": true, "type": "arrow"},
        "/drivers/nav/route/path": {"visible": true, "lineWidth": 0.1, "color": "#9c27b0"},
        "/safety/collision_monitor/stop_zone": {"visible": true},
        "/safety/ghost/marker": {"visible": true}
      }
    },
    "Image!camera": {
      "imageMode": {"imageTopic": "/perception/camera/front_left/preview/compressed"}
    },
    "Indicator!estop": {
      "path": "/vehicle/status.estop_active",
      "style": "background",
      "fallbackColor": "#2e7d32",
      "fallbackLabel": "No e-stop",
      "rules": [{"operator": "=", "rawValue": "true", "color": "#c62828",
                 "label": "E-STOP"}]
    },
    "Indicator!watchdog": {
      "path": "/safety/sensor_watchdog/lock.data",
      "style": "background",
      "fallbackColor": "#2e7d32",
      "fallbackLabel": "Sensors OK (or no watchdog yet)",
      "rules": [{"operator": "=", "rawValue": "true", "color": "#c62828",
                 "label": "STOP: a sensor Nav2 needs has failed"}]
    },
    "RawMessages!gate": {
      "topicPath": "/safety/output_mux/state.data",
      "diffEnabled": false,
      "expansion": "all"
    },
    "Plot!speed": {
      "paths": [
        {"value": "/vehicle/odom.twist.twist.linear.x", "enabled": true,
         "timestampMethod": "receiveTime", "label": "measured speed (m/s)"},
        {"value": "/control/cmd_vel.twist.linear.x", "enabled": true,
         "timestampMethod": "receiveTime", "label": "commanded speed (m/s)"}
      ],
      "showLegend": true,
      "xAxisVal": "timestamp",
      "followingViewWidth": 30
    },
    "Plot!steering": {
      "paths": [
        {"value": "/vehicle/steering.measured", "enabled": true,
         "timestampMethod": "receiveTime", "label": "measured steering (rad, + left)"},
        {"value": "/vehicle/steering.command", "enabled": true,
         "timestampMethod": "receiveTime", "label": "commanded steering (rad)"}
      ],
      "showLegend": true,
      "xAxisVal": "timestamp",
      "followingViewWidth": 30
    }
  },
  "globalVariables": {},
  "userNodes": {},
  "layout": {
    "direction": "row",
    "splitPercentage": 62,
    "first": {
      "direction": "column",
      "splitPercentage": 65,
      "first": "3D!driving",
      "second": "Image!camera"
    },
    "second": {
      "direction": "column",
      "splitPercentage": 12,
      "first": "Indicator!estop",
      "second": {
        "direction": "column",
        "splitPercentage": 14,
        "first": "Indicator!watchdog",
        "second": {
          "direction": "column",
          "splitPercentage": 14,
          "first": "RawMessages!gate",
          "second": {
            "direction": "column",
            "splitPercentage": 50,
            "first": "Plot!speed",
            "second": "Plot!steering"
          }
        }
      }
    }
  }
}
