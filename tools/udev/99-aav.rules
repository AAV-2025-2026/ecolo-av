# Stable device names for the car's USB devices: /dev/aav/<name> instead of ttyUSB0/1/2,
# whose order changes with plug order. The configs use these names.
#
# Install on each machine that has devices plugged in:
#   sudo cp tools/udev/99-aav.rules /etc/udev/rules.d/ && sudo udevadm control --reload \
#     && sudo udevadm trigger
# Find a device's IDs:   udevadm info -a -n /dev/ttyUSB0 | grep -E 'idVendor|idProduct|serial'
#
# TODO fill in ATTRS{serial} for each device: two of the same USB-serial chip only differ
# by serial number. The vendor/product IDs below are common values, not checked on our parts.

# Yahboom IMU (CH340 USB-serial: 1a86:7523)
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", ATTRS{serial}=="TODO", SYMLINK+="aav/imu", MODE="0666"

# TI IWR6843AOP radar: two ports on one CP2105 (10c4:ea70); interface 00 = command, 01 = data
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea70", ENV{ID_USB_INTERFACE_NUM}=="00", SYMLINK+="aav/radar_cmd", MODE="0666"
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea70", ENV{ID_USB_INTERFACE_NUM}=="01", SYMLINK+="aav/radar_data", MODE="0666"

# Victron VE.Direct USB cable (FTDI 0403:6015)
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6015", ATTRS{serial}=="TODO", SYMLINK+="aav/battery", MODE="0666"

# u-blox F9P (USB, used through libusb, not a tty). From ublox_dgnss's README (0.7.4).
ATTRS{idVendor}=="1546", ATTRS{idProduct}=="01a9", MODE="0666", GROUP="plugdev", ENV{ID_MM_DEVICE_IGNORE}="1"
# Cameras (usb_cam, aav_sensors cameras.launch.py). TODO: the models are Q22; fill in their
# IDs from `udevadm info -a -n /dev/video0`. index 0 is a camera's image stream.
SUBSYSTEM=="video4linux", ATTRS{idVendor}=="TODO", ATTRS{serial}=="TODO", ATTR{index}=="0", SYMLINK+="aav/camera_left", MODE="0666"
SUBSYSTEM=="video4linux", ATTRS{idVendor}=="TODO", ATTRS{serial}=="TODO", ATTR{index}=="0", SYMLINK+="aav/camera_right", MODE="0666"
# A GPS speaking NMEA over USB serial (aav_sensors gps_nmea.launch.py). TODO: its chip, Q18.
SUBSYSTEM=="tty", ATTRS{idVendor}=="TODO", ATTRS{idProduct}=="TODO", SYMLINK+="aav/gps", MODE="0666"
