# The HUD (the instrument cluster), full screen on the dash's small screen, from the
# desktop's start until it ends. A systemd *user* unit: it runs as the logged-in user, in
# the desktop's session, and needs no sudo. docs/car-screens.md.
#
# Installed to ~/.config/systemd/user/ by tools/car_screens_install.sh.
# Its log:   journalctl --user -u aav-hud -f
# Stop it:   systemctl --user stop aav-hud      (until the next boot)
# Never:     systemctl --user disable aav-hud
# Which monitor, which ROS domain: ~/.config/aav/screens.env

[Unit]
Description=AAV HUD: the instrument cluster, full screen on its own monitor
Documentation=https://github.com/AAV-2025-2026/ecolo-av/blob/main/docs/car-screens.md
# With the desktop: started once it's up, stopped when it ends.
After=graphical-session.target
PartOf=graphical-session.target
# Keep trying for ever: the car's screen must not stay dark after a crash.
StartLimitIntervalSec=0

[Service]
Type=exec
# aav.sh: our Jazzy, apart from the car's Humble. car_screen.sh reads screens.env.
ExecStart=%h/aav-jazzy/aav.sh tools/car_screen.sh hud
# Any exit, a crash or a closed window, starts it again 5 s later...
Restart=always
RestartSec=5
# ...except 78: screens.env is wrong or unfinished (the journal says what). Fix, then
# systemctl --user restart aav-hud
RestartPreventExitStatus=78
TimeoutStopSec=10
SyslogIdentifier=aav-hud

[Install]
WantedBy=graphical-session.target
