    version: 513b36e6323b4ceb4b49d832dc7d163331e1cd11
  # ros-jazzy-ros-gz 1.0.24 (tag 1.0.24, on the jazzy branch)
  ros_gz:
    type: git
    url: https://github.com/gazebosim/ros_gz.git
    version: 5912bfe7976a79d2cc9f373b2d40a8a3a3e33da2
  # sdformat14_14.8.0
  sdformat:
